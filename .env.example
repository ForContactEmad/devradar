# ═════════════════════════════════════════════════════════════════════════════
# DevRadar — docker compose environment
#
#   cp .env.example .env
#   # set the three passwords below, then:
#   docker compose up
#
# This file is read by compose AND by the backend containers (env_file).
# It is the only place secrets live. Nothing here is baked into an image.
# ═════════════════════════════════════════════════════════════════════════════

# ── Required. Compose refuses to start without these, deliberately: a default
#    password in a compose file is a password in production.
#    Generate with:  php -r "echo bin2hex(random_bytes(24));"
POSTGRES_PASSWORD=
REDIS_PASSWORD=

POSTGRES_DB=devradar
POSTGRES_USER=devradar

# ── Host ports. Change if 8000 or 3000 are already taken.
API_PORT=8000
FRONTEND_PORT=3000

# ── Reached from the BROWSER, so it must be host-visible. `http://api:8000`
#    resolves only between containers and fails in the user's tab.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ── Laravel
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_DATABASE=devradar
DB_USERNAME=devradar
DB_PASSWORD=${POSTGRES_PASSWORD}

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Admin endpoints are FAIL-CLOSED. Unset, or under 32 characters, denies
#    every request. An unconfigured deployment serves no operational data.
#    php -r "echo bin2hex(random_bytes(32));"
DEVRADAR_ADMIN_TOKEN=

# ── External providers. The pipeline degrades rather than breaking when these
#    are absent: collection stops, and everything downstream keeps running.
X_API_BEARER_TOKEN=
DEVRADAR_AI_PROVIDER=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# ── Spend ceiling. Collection aborts rather than exceeding it.
DEVRADAR_MONTHLY_CEILING_USD=40
