#-------------------------------------------------------------------------
# DevRadar backend environment template
#-------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env -- it is gitignored.
# Every value here is a placeholder. No real credential belongs in this file.
#-------------------------------------------------------------------------

APP_NAME=DevRadar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

#-------------------------------------------------------------------------
# Database (PostgreSQL -- pg_trgm is required for deduplication)
#-------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=devradar
DB_USERNAME=devradar
DB_PASSWORD=change-me-locally

#-------------------------------------------------------------------------
# Cache / queue
#-------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

#-------------------------------------------------------------------------
# Cost controls -- BRAKE 1 OF 2
#-------------------------------------------------------------------------
# The second brake is the spending limit set in the X developer console.
# Both must be configured. Neither substitutes for the other.
#
# DEVRADAR_MAX_POSTS_PER_RUN is the hard per-run ceiling enforced in code,
# independent of any provider-side limit. A runaway pagination loop is the
# single most expensive bug this project can have.
#-------------------------------------------------------------------------
DEVRADAR_MONTHLY_CEILING_USD=40
DEVRADAR_MAX_POSTS_PER_RUN=300
DEVRADAR_BUDGET_ALERT_PERCENT=70
DEVRADAR_HALT_ON_CEILING=true

# Verify these against the developer console before trusting them.
# Provider pricing has changed more than once.
DEVRADAR_PRICE_POST_READ_USD=0.005
DEVRADAR_PRICE_USER_READ_USD=0.010

#-------------------------------------------------------------------------
# Pipeline
#-------------------------------------------------------------------------
DEVRADAR_WINDOW_DAYS=7
DEVRADAR_INGESTION_QUEUE=ingestion
DEVRADAR_PROCESSING_QUEUE=processing
DEVRADAR_CLASSIFY_BATCH=20
DEVRADAR_ENRICHMENT_ENABLED=true

#-------------------------------------------------------------------------
# X API
#-------------------------------------------------------------------------
# The bearer token is app-only OAuth 2.0, generated in the developer console.
# It is a password: it grants full API access on behalf of the app. It must
# exist ONLY here or in a secret manager -- never in code, never in a commit,
# never in a log, never baked into an image.
#
# The metered client is the sole component permitted to use it, and it must
# consult the budget guard before every request.
#-------------------------------------------------------------------------
X_API_BASE_URL=https://api.x.com/2
X_API_BEARER_TOKEN=

# Verified limit: 512 chars for recent search on non-Enterprise access.
X_MAX_QUERY_LENGTH=512
X_TIMEOUT_SECONDS=20

X_MAX_RETRIES=3
X_BASE_BACKOFF_SECONDS=1
X_MAX_BACKOFF_SECONDS=60

# Author objects are billed separately, at twice the post rate. Disabling
# this is a real cost lever but leaves the author cache unpopulated.
X_EXPAND_AUTHORS=true

# DevRadar's own paging brakes. Verified: max 100 posts per request.
X_PAGE_SIZE=100
X_MAX_PAGES_PER_RUN=5

# Live smoke test. Costs real credits. Never enable in CI.
X_LIVE_SMOKE=0

#-------------------------------------------------------------------------
# AI provider -- NOT IMPLEMENTED YET (phase 5)
#-------------------------------------------------------------------------
# Switching providers is a configuration change, not a code change.
# Supported values: anthropic | openai | openai_compatible | local | fake
#-------------------------------------------------------------------------
# Supported: anthropic | openai_compatible | mock
DEVRADAR_AI_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Also covers OpenRouter, Together, Groq, and a local Ollama or vLLM server.
# A local server usually needs no key; leave it blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROVIDER_NAME=openai

# Verdicts below this are stored as low_confidence, not discarded.
DEVRADAR_MIN_CONFIDENCE=0.75

DEVRADAR_AI_TIMEOUT=30
DEVRADAR_AI_MAX_TOKENS=512
DEVRADAR_AI_MAX_RETRIES=3
DEVRADAR_AI_BATCH=50

DEVRADAR_AI_CACHE=true
DEVRADAR_AI_CACHE_TTL=604800

# BUMP THIS WHENEVER THE PROMPT CHANGES. Without it the cache serves answers
# from the old prompt and past decisions become unattributable.
DEVRADAR_PROMPT_VERSION=v1

# Verify against the provider's current pricing; these are assumptions.
DEVRADAR_AI_INPUT_TOKEN_USD=0.000003
DEVRADAR_AI_OUTPUT_TOKEN_USD=0.000015

#-------------------------------------------------------------------------
# GitHub enrichment
#-------------------------------------------------------------------------
# Off the critical path. Absence degrades quietly; it never blocks the feed.
#
# SET A TOKEN. Unauthenticated is 60 requests/hour; a personal access token
# gives 5,000. More importantly, conditional requests (ETag -> 304) are only
# free against the rate limit when an Authorization header is present --
# without one, a 304 still costs a request. The discount is missing exactly
# where the budget is tight.
#
# A fine-grained token with public read access is sufficient.
#-------------------------------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_TIMEOUT=15

# Second request per repository; defaults off without a token.
GITHUB_FETCH_CONTRIBUTORS=true

GITHUB_MAX_RETRIES=3
GITHUB_REFRESH_AFTER_MINUTES=720
GITHUB_ENRICH_BATCH=50
GITHUB_MAX_FAILURES=5
GITHUB_QUOTA_RESERVE=50

#-------------------------------------------------------------------------
# Compliance
#-------------------------------------------------------------------------
DEVRADAR_PURGE_WITHIN_HOURS=24
DEVRADAR_RECONCILE_BATCH=100

#-------------------------------------------------------------------------
# Compliance -- LEGAL OBLIGATION
#-------------------------------------------------------------------------
# X's developer policy requires stored content to reflect what is still
# public on X. Deleted posts, protected and suspended accounts must stop
# being displayed. Non-compliance risks losing API access entirely.
#
# Uses the same X_API_BEARER_TOKEN as collection.
#-------------------------------------------------------------------------
DEVRADAR_COMPLIANCE_RECHECK_HOURS=24
DEVRADAR_COMPLIANCE_BATCH=10000
DEVRADAR_COMPLIANCE_TIMEOUT=60
DEVRADAR_CRON_COMPLY="*/15 * * * *"

# A cycle stalled longer than this is an incident, not a slow job.
DEVRADAR_COMPLIANCE_ALERT_HOURS=26

#-------------------------------------------------------------------------
# Security
#-------------------------------------------------------------------------
# Admin endpoints are FAIL-CLOSED: unset or under 32 characters denies every
# request. This is not a placeholder -- an unconfigured deployment serves no
# operational data at all.
#
#   php -r "echo bin2hex(random_bytes(32));"
DEVRADAR_ADMIN_TOKEN=

# Requests per minute per IP. Search is tighter because each call is a real
# query the cache cannot always absorb.
DEVRADAR_RATE_PUBLIC=120
DEVRADAR_RATE_SEARCH=30
DEVRADAR_RATE_ADMIN=20

# Comma-separated origins, or * for the public read API. NEVER combine a
# wildcard with credentialed requests.
DEVRADAR_CORS_ORIGINS=*

# Required by docker-compose; it refuses to start without them.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
