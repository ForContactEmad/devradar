# Frontend environment template. Copy to .env. Never commit .env.
#
# Only PUBLIC values belong here -- anything in NUXT_PUBLIC_* ships to the
# browser. API keys and provider credentials live in the backend environment.

# Point at the real Laravel API, or at the bundled mock while the backend
# cannot be installed (npm run mock-api).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
